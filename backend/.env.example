APP_NAME=CruxSIEM
DEBUG=true

OPENSEARCH_HOST=ns1.cruxdata.co.kr
OPENSEARCH_PORT=11723
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

CORS_ORIGINS=["http://localhost:5173"]

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_EXPIRE_MINUTES_REMEMBER=10080

# OTP Settings
# ⚠️  배포 필수: OTP 비밀 키 암호화에 사용되는 AES-256 키
# 반드시 32자(256bit) 이상의 무작위 문자열을 생성하여 설정하세요
# 생성 명령: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️  주의: 이 값이 변경되면 기존 OTP 등록 사용자들의 인증이 모두 무효화됩니다
OTP_ENCRYPTION_KEY=change-me-to-a-32-byte-or-longer-random-secret-key-here

# OTP 동작 설정 (선택)
OTP_ISSUER=CruxSIEM
OTP_MAX_ATTEMPTS=5
OTP_TIME_WINDOW=2
