# Application Settings
APP_NAME=cruxSIEM
DEBUG=false
TAG=latest

# SSL Settings
SSL_ENABLED=true
SSL_CERT_PATH=/conf/certs/site.crt
SSL_KEY_PATH=/conf/certs/site.key

# OpenSearch Connection
# For 'host.docker.internal' to work, ensure extra_hosts is configured in docker-compose
OPENSEARCH_HOST=host.docker.internal
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=your_password_here
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true
# Path to CA certificate inside the container (e.g., /app/certs/ca.pem)
# Ensure this file is mounted via docker-compose.prod.yml if needed
OPENSEARCH_CA_CERTS=

# JWT Settings (Change this in production!)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OTP Settings
# ⚠️  배포 필수: OTP 비밀 키 암호화에 사용되는 AES-256 키 (32자 이상 랜덤 문자열)
# ⚠️  주의: 이 값이 변경되면 기존 OTP 등록 사용자들의 인증이 모두 무효화됩니다
OTP_ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_OR_LONGER_RANDOM_SECRET_KEY
OTP_ISSUER=cruxSIEM
