{
      "name": "threats_index_template",
      "index_template": {
        "index_patterns": [
          "logs-sentinel_one.threats-*"
        ],
        "template": {
          "settings": {
            "index": {
              "refresh_interval": "1s",
              "number_of_shards": "1",
              "number_of_replicas": "1",
              "plugins": {
                "index_state_management": {
                  "policy_id": "sentinel_one_policy",
                  "rollover_alias": "logs-sentinel_one.threats"
                }
              }
            }
          },
          "mappings": {
            "properties": {
              "@timestamp": {
                "type": "date"
              },
              "kubernetesInfo": {
                "type": "object"
              },
              "threatInfo": {
                "type": "object",
                "properties": {
                  "threatId": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "isValidCertificate": {
                    "type": "boolean"
                  },
                  "mitigationStatusDescription": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "confidenceLevel": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "mitigationStatus": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "rebootRequired": {
                    "type": "boolean"
                  },
                  "externalTicketExists": {
                    "type": "boolean"
                  },
                  "originatorProcess": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "sha256": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "certificateId": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "classificationSource": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "processUser": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "reachedEventsLimit": {
                    "type": "boolean"
                  },
                  "fileVerificationType": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "analystVerdictDescription": {
                    "ignore_above": 256,
                    "type": "keyword"
                  },
                  "automaticallyResolved": {
                    "type": "boolean"
                  },
                  "createdAt": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                  },
                  "detectionEngines": {
                    "type": "object",
