{
      "name": "agents_index_template",
      "index_template": {
        "index_patterns": [
          "logs-sentinel_one.agents-*"
        ],
        "template": {
          "settings": {
            "index": {
              "refresh_interval": "1s",
              "number_of_shards": "1",
              "number_of_replicas": "1",
              "plugins": {
                "index_state_management": {
                  "policy_id": "sentinel_one_policy",
                  "rollover_alias": "logs-sentinel_one.agents"
                }
              }
            }
          },
          "mappings": {
