              "mitigationMode": {
                "ignore_above": 256,
                "type": "keyword"
              },
              "groupId": {
                "ignore_above": 256,
                "type": "keyword"
              },
              "osArch": {
                "ignore_above": 256,
                "type": "keyword"
              },
